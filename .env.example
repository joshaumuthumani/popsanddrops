# Firebase Web App config (client-safe — security is enforced by Firestore Rules).
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server-side only (Cloud Functions); DO NOT prefix with VITE_ and never commit real values ---
# RESEND_API_KEY=
# RESEND_FROM="Pops & Drops <picks@your-domain.com>"
# APP_PUBLIC_URL=https://your-app-domain.com
